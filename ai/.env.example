# DateFlow AI 에이전트 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 실제 키를 채워서 사용하세요.

# Google Gemini API 키
GOOGLE_API_KEY=your_google_api_key_here
# 사용할 Gemini 모델 (기본 gemini-flash-latest)
GEMINI_MODEL=gemini-3-flash-preview
# 분당 호출 수 제한 (무료 등급 5회/분 → 4). 결제 연결한 키면 올려도 됨
GEMINI_RPM=4

# 카카오 REST API 키 (Local API / Map)
KAKAO_KEY=your_kakao_rest_api_key_here

# 네이버 개발자 API
DEV_ID=your_naver_client_id_here
DEV_SECRET=your_naver_client_secret_here
