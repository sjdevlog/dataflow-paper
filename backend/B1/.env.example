# backend/B1 환경 변수 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.

DATABASE_URL=sqlite:///./dateflow.db
SECRET_KEY=dev-secret-key

# 공공데이터포털 '기상청_단기예보 조회서비스' — 일반 인증키(Encoding) 사용
KMA_API_KEY=

# Kakao Developers 앱의 'REST API 키' (프론트의 JavaScript 키와 다름)
# 장소 좌표 조회 + 카카오모빌리티 길찾기(이동시간)에 사용
KAKAO_REST_API_KEY=

# AI 추천(Gemini) — ai/.env 에 넣어도 됨 (B1 이 ai/.env 도 읽음)
GOOGLE_API_KEY=

# 선택: 기본값과 다를 때만
# B2_URL=http://localhost:8001
# AI_PATH=C:/Users/.../dateflow/ai
